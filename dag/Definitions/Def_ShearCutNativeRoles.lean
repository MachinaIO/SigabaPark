def table : Array Row := part0 ++ part1 ++ part2 ++ part3 ++ part4 ++ part5 ++ part6 ++ part7 ++ part8 ++ part9 ++ part10 ++ part11 ++ part12 ++ part13 ++ part14 ++ part15 ++ part16 ++ part17 ++ part18 ++ part19 ++ part20 ++ part21 ++ part22 ++ part23 ++ part24 ++ part25 ++ part26 ++ part27 ++ part28 ++ part29 ++ part30 ++ part31 ++ part32 ++ part33 ++ part34 ++ part35 ++ part36 ++ part37 ++ part38 ++ part39 ++ part40 ++ part41 ++ part42 ++ part43 ++ part44
def padStart:= 4654237
def padEnd:= 4673461
def bound:= 4685687
def stateCount:=2*bound+16
def rowSearch (pos : Nat) : Nat→Nat→Nat→Row
| 0,lo,_ => table[lo]!
| t+1,lo,hi =>
  if hi≤lo+1 then table[lo]! else
  let j:=(lo+hi)/2
  if table[j]!.1≤pos then rowSearch pos t j hi else rowSearch pos t lo j
def token (pos : Nat) : Row :=
  if padStart≤pos && pos<padEnd then
    let start:=padStart+((pos-padStart)/6)*6
    if pos<start+4 then (start,3,0) else (start+4,1,0)
  else rowSearch pos 14 0 table.size
def act (q : Nat) (inp : Option Bool) : Nat × Option Bool :=
  let finish:=2*bound
  let fail:=finish+8
  if q<finish then
    let pos:=q/2
    let flag:=q%2
    let advance:=2*(pos+1)+flag
    if pos<1031 then
      if inp==some (!(pos==513 || pos==1027 || pos==1029 || pos==1030)) then (advance,none) else (fail,none)
    else
      let (start,size,key):=token pos
      if pos==start+size then
        (if inp==some false then advance else fail,none)
      else if inp==some true then (advance,none)
      else if inp==some false && key>0 && pos+1==start+key then (2*(start+size+1)+1,none)
      else (fail,none)
  else
    let t:=q-finish
    match t with
    | 0 | 1 => (if inp==some false then q+2 else fail,none)
    | 2 | 3 => (if inp==some true then q+2 else fail,none)
    | 4 | 5 => (if inp.isSome then finish+6+(if t==5 && inp==some true then 1 else 0) else fail,none)
    | 6 | 7 => (if inp==some false then finish+12+t%2 else fail,none)
    | 12 | 13 => (if inp.isNone then finish+8+t%2 else fail,none)
    | 8 | 9 => (q+2,some true)
    | 10 | 11 => (finish+14,some (t==11))
    | _ => (stateCount,some false)
def enc : Machine where
  tapes:=0
  states:=stateCount
  time:=bound+12
  machine:={
    initial:=⟨0,by decide⟩
    tr:=fun q inp _ _ _ =>
      let a:=act q.val inp
      .step {inputTape:=1, workTapes:=Fin.elim0, output:=a.2,
              state:=if h:a.1<stateCount then some ⟨a.1,h⟩ else none}
        Fin.elim0 Fin.elim0}
def dec : Machine where
  tapes := 0
  states := 7
  time := 210000000
  machine := {
    initial := ⟨0,by decide⟩
    tr := fun q inp _ _ _ =>
      let i:=q.val
      let n:=if i==6 then 6 else if i%2==1 then i-1 else if inp==some true then i+1 else i+2
      .step {inputTape := 1,workTapes := Fin.elim0,
             output := if i==6 then inp else none
             state := if inp.isNone then none else if h : n<7 then some ⟨n,h⟩ else none}
            (fun j => Fin.elim0 j) (fun j => Fin.elim0 j)}
end ShearCutRole
