import Mathlib.Tactic

set_option autoImplicit true

/-! Kernel-checked short primitive normals for all nontrivial affine relations mod3329. -/
set_option maxRecDepth 20000
set_option maxHeartbeats 8000000
namespace SigabaNeo.Wall1.AffineNormalCertificate

/-- A record stores the affine parameter and the first two normal coefficients. -/
def Valid (r : ℕ × ℤ × ℤ) : Prop :=
  let t := (r.1 : ℤ)
  let u := r.2.1
  let v := r.2.2
  let w := -u-v
  2 ≤ r.1 ∧ r.1 ≤ 3328 ∧
  u % 3329 ≠ 0 ∧ v % 3329 ≠ 0 ∧ w % 3329 ≠ 0 ∧
  Int.gcd u v = 1 ∧
  6 ≤ u*u+v*v+w*w ∧ u*u+v*v+w*w ≤ 6422 ∧
  (u+(1-t)*w) % 3329 = 0 ∧ (v+t*w) % 3329 = 0

instance (r : ℕ × ℤ × ℤ) : Decidable (Valid r) := by
  unfold Valid
  infer_instance

