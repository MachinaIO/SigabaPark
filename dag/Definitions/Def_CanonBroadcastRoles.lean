/-- A physical framing-bit recognizer with one tape holding two marks 64 cells apart. -/
def enc : Machine where
  tapes := 1
  states := 6845112
  time := 105000000
  machine := {
    initial := ⟨0,by decide⟩
    tr := fun q inp ws _ _ =>
      let i:=q.val
      let body:=2630580
      let pc:=i-body
      let z:=ops[pc]?.getD 7
      let op:=z%16
      let mark:=(ws 0).isSome
      let one:=inp==some true
      let atOp:=i≥body
      let err:=1100
      let tag := i≥1140 && i<body
      let p:=i-1140
      let slot:=p/(32*913)
      let mask:=p/913%32
      let ix:=p%913
      let phase:=if ix<3 then ix else 3+(ix-3)/130
      let k:=(ix-3)%130
      let idx:=fun (j m ph c : Nat) => 1140+(32*j+m)*913+(if ph<3 then ph else 3+(ph-3)*130+c)
      let top:=(ws 0)==some true
      let first:=(ws 0)==some false
      let ft:=if phase<3 then (if one then idx slot mask (phase+1) 0 else err)
        else if phase==3 then
          (if one then (if k<129 then idx slot mask 4 k else err)
           else if inp==some false && (k==0 || k==129 || k==slot+1) then
             let typ:=if k==0 then 0 else if k==129 then 1 else 2
             idx slot (dp[96*slot+3*mask+typ]?.getD 0) 6 k
           else err)
        else if phase==4 then (if !one then err else if top then idx slot mask 5 k else i)
        else if phase==5 then (if top then idx slot mask 3 (k+1) else if one then i else err)
        else if phase==6 then (if one then idx slot mask 7 k else err)
        else if phase==7 then
          (if k==0 then (if inp != some false then err else if slot<89 then idx (slot+1) mask 0 0
                          else if mask &&& 21 != 0 then body else err)
           else if one then idx slot mask 8 k else err)
        else if phase==8 then (if !one then err else if first then idx slot mask 9 k else i)
        else (if top then idx slot mask 7 (k-1) else if one then i else err)
