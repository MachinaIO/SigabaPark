import Mathlib
namespace BroadcastWire
open SigabaNeo Turing.MultiTapeTM AdvancedEncryption.WE.CircuitSAT
def stuff (w : List Bool) := w.flatMap (fun b => [true,b])
theorem stuff_append (a b : List Bool) : stuff (a++b)=stuff a ++ stuff b := by simp [stuff]
theorem ones_subst (n : Nat) : stuff (List.replicate n true)=List.replicate (2*n) true := by
  induction n with
  | zero => rfl
  | succ n ih =>
    rw [List.replicate_succ]
    change true::true::stuff (List.replicate n true) = _
    rw [ih,show 2*(n+1)=2*n+1+1 by omega,List.replicate_succ,List.replicate_succ]
theorem frame' (w : List Bool) : frame w=stuff w++[false] := rfl
theorem two (a b : Nat) :
    stuff (frame (encGate (a,b))) =
      List.replicate (8*a+3) true++[false]++List.replicate (4*b+1) true++[false] := by
  simp only [encGate,encPair_apply,encUnary_apply,frame',stuff_append,ones_subst]
  simp only [show stuff [false]=[true,false] by rfl,show stuff [true,false]=[true,true,true,false] by rfl]
  simp only [List.append_assoc]
  rw [show 8*a+3=2*(2*(2*a))+3 by omega,show 4*b+1=2*(2*b)+1 by omega,
      List.replicate_add,List.replicate_add]
  simp [List.append_assoc]
