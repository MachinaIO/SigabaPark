        else if i==1111 then (if one then 1113 else if inp==some false then 1112 else err)
        else if i==1112 || i==1113 then (if inp==some false then i+2 else err)
        else if i==1114 || i==1115 then (if inp.isNone then i+2 else err)
        else if i==1116 || i==1117 then i+2
        else if i==1118 || i==1119 then 1120
        else if tag then ft else if !atOp then 0
        else if op==0 then (if inp==some false then i+1 else err)
        else if op==1 || op==2 then (if one then i+1 else err)
        else if op==3 then (if !one then err else if mark then i+1 else i)
        else if op==4 then (if mark then i+1 else if !one then err else i)
        else if op==5 then (if one then body+z/16 else if inp==some false then i+1 else err)
        else if op==6 then body+z/16
