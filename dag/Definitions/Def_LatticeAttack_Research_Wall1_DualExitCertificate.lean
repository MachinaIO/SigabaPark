module

public import Mathlib

set_option autoImplicit true

/-! Integer witnesses for the 408 Part 172 radius and charge enclosures.
Each row gives upper radius, lower half-square-root of dimension (both scaled by 10^8),
and upper exit charge (scaled by 10^23). The radius uses the lower endpoint for the
unit-ball volume, and the charge uses its upper endpoint. The endpoints replace
2π by consecutive rationals with denominator 10^15 in the double-factorial formula.
The four inequalities in `Valid` verify these one-sided approximations independently of how
the witnesses were generated. -/

@[expose] public section

namespace SigabaNeo.Wall1.DualExit.Certificate

abbrev scale : ℕ := 10^8
abbrev chargeScale : ℕ := 10^23
abbrev piScale : ℕ := 10^15
abbrev twoPiLo : ℕ := 6283185307179586
abbrev twoPiHi : ℕ := 6283185307179587

def volumeDen (d : ℕ) := piScale^(d/2) * d.doubleFactorial
def volumeNum (p d : ℕ) := (1 + d%2) * p^(d/2)

/-- Numerators and denominators are kept separate for division-free kernel checks. -/
def Valid (t : Fin 408) (b s p : ℕ) : Prop :=
  let n := 105 + t.val
  let d := 400 + n
  4*s^2 ≤ d*scale^2 ∧ d*scale^2 ≤ 4*b^2 ∧
    3329^n * volumeDen d * scale^d ≤ 408000 * volumeNum twoPiLo d * (b+s)^d ∧
    chargeScale^2 * (volumeNum twoPiHi d)^2 * (4*b^2 + d*scale^2)^d ≤
      p^2 * (volumeDen d)^2 * 3329^(2*n) * (4*scale^2)^d

instance (t : Fin 408) (b s p : ℕ) : Decidable (Valid t b s p) := by unfold Valid; infer_instance

