import Definitions.Def_LatticeAttack_Research_Wall1_ProjectionDual
import CslibFrontier.Foundations.Analysis.Lattice.Minimum

set_option autoImplicit true

/-! # Marked quotients and integer sections (Part 142, Theorem A1–A3) -/

noncomputable section

namespace SigabaNeo.Wall1

open Submodule ZLattice
open scoped RealInnerProductSpace

variable {V : Type*} [NormedAddCommGroup V] [InnerProductSpace ℝ V] [FiniteDimensional ℝ V]
variable {ι η : Type*}

/-- The preimage in the retained space of the marks generated by the classes of `g i`. -/
def markedPreimage (L : Submodule ℤ V) (g : ι → V) : Submodule ℤ V :=
  ((span ℤ (Set.range g)).map L.mkQ).comap L.mkQ

omit [InnerProductSpace ℝ V] [FiniteDimensional ℝ V] in
theorem markedPreimage_eq (L : Submodule ℤ V) (g : ι → V) :
    markedPreimage L g = L ⊔ span ℤ (Set.range g) := L.comap_map_mkQ _

/-- Projecting before forming the marked quotient gives the projection of the generated module. -/
theorem markedPreimage_projected (M : Submodule ℤ V) (g : ι → V) (S : Submodule ℝ V) :
    markedPreimage (projectedModule M S) (fun i ↦ S.orthogonalProjectionOnto (g i)) =
      projectedModule (M ⊔ span ℤ (Set.range g)) S := by
  rw [markedPreimage_eq, projectedModule, projectedModule, Submodule.map_sup, Submodule.map_span]
  simp [← Set.range_comp, Function.comp_def]

omit [InnerProductSpace ℝ V] [FiniteDimensional ℝ V] in
/-- Graph columns `a j + t j` with horizontal offsets and the horizontal generators recover
all coordinate directions, for arbitrary index types and modulus. -/
theorem graph_sup_horizontal (q : ℕ) (g : ι → V) (t a : η → V)
    (ha : ∀ j, a j ∈ span ℤ (Set.range g)) :
    (span ℤ (Set.range (fun i ↦ q • g i)) ⊔ span ℤ (Set.range (fun j ↦ a j + t j))) ⊔
      span ℤ (Set.range g) = span ℤ (Set.range (Sum.elim g t)) := by
  let H := span ℤ (Set.range g)
  let M := span ℤ (Set.range (fun i ↦ q • g i)) ⊔ span ℤ (Set.range (fun j ↦ a j + t j))
  let Z := span ℤ (Set.range (Sum.elim g t))
  have hH : H ≤ Z := span_le.mpr (by rintro _ ⟨i, rfl⟩; exact subset_span ⟨Sum.inl i, rfl⟩)
  apply le_antisymm
  · refine sup_le (sup_le (span_le.mpr ?_) (span_le.mpr ?_)) hH
    · rintro _ ⟨i, rfl⟩
      exact Z.toAddSubmonoid.nsmul_mem (hH (subset_span ⟨i, rfl⟩)) q
    · rintro _ ⟨j, rfl⟩
      exact Z.add_mem (hH (ha j)) (subset_span ⟨Sum.inr j, rfl⟩)
  · apply span_le.mpr
    rintro _ ⟨i | j, rfl⟩
    · exact Submodule.mem_sup_right (subset_span ⟨i, rfl⟩ : g i ∈ H)
    · have hcol : a j + t j ∈ M := Submodule.mem_sup_right (subset_span ⟨j, rfl⟩)
      change t j ∈ M ⊔ H
      simpa using (M ⊔ H).sub_mem (Submodule.mem_sup_left hcol) (Submodule.mem_sup_right (ha j))

/-- The cubic integer lattice in an orthonormal coordinate system. -/
abbrev cubicModule [Fintype ι] (b : OrthonormalBasis ι ℝ V) := span ℤ (Set.range b.toBasis)

omit [FiniteDimensional ℝ V] in
theorem metricDual_cubicModule [Fintype ι] (b : OrthonormalBasis ι ℝ V) :
    metricDual (cubicModule b) = cubicModule b := by
  ext x
  let T := (1 : Submodule ℤ ℝ).comap (((innerₗ V) x).restrictScalars ℤ)
  change span ℤ (Set.range b.toBasis) ≤ T ↔ _
  rw [span_le, cubicModule, b.toBasis.mem_span_iff_repr_mem ℤ x]
  simp only [Set.range_subset_iff, OrthonormalBasis.coe_toBasis_repr_apply,
    OrthonormalBasis.repr_apply_apply]
  constructor <;> intro h i
  · rw [real_inner_comm]
    exact Submodule.mem_one.mp (h i)
  · change ⟪x, b i⟫ ∈ (1 : Submodule ℤ ℝ)
    rw [real_inner_comm]
    exact Submodule.mem_one.mpr (h i)

/-- The integer section inside `S`, with its induced Euclidean norm. -/
abbrev integerSection [Fintype ι] (b : OrthonormalBasis ι ℝ V) (S : Submodule ℝ V) :=
  (cubicModule b).comap (S.subtype.restrictScalars ℤ)

theorem metricDual_projected_cubic [Fintype ι] (b : OrthonormalBasis ι ℝ V) (S : Submodule ℝ V) :
    metricDual (projectedModule (cubicModule b) S) = integerSection b S := by
  rw [metricDual_projectedModule, metricDual_cubicModule]

/-- When the cubic projection is discrete, the integer section is full rank in `S`. -/
theorem integerSection_lattice [Fintype ι] (b : OrthonormalBasis ι ℝ V) (S : Submodule ℝ V)
    [DiscreteTopology (projectedModule (cubicModule b) S)] :
    ∃ _ : DiscreteTopology (integerSection b S), IsZLattice ℝ (integerSection b S) := by
  rw [← metricDual_projected_cubic]
  have : IsZLattice ℝ (projectedModule (cubicModule b) S) := ⟨projectedModule_span_top _ _⟩
  let := discreteTopology_dualSubmodule (projectedModule (cubicModule b) S)
  exact ⟨inferInstance, isZLattice_dualSubmodule _⟩

omit [FiniteDimensional ℝ V] in
theorem integerSection_integral [Fintype ι] (b : OrthonormalBasis ι ℝ V) (S : Submodule ℝ V)
    {x y : S} (hx : x ∈ integerSection b S) (hy : y ∈ integerSection b S) :
    ⟪x, y⟫ ∈ (1 : Submodule ℤ ℝ) := by
  have hx' : (x : V) ∈ metricDual (cubicModule b) := (metricDual_cubicModule b).symm ▸ hx
  exact hx' _ hy

omit [FiniteDimensional ℝ V] in
theorem integerSection_minimum [Fintype ι] (b : OrthonormalBasis ι ℝ V) (S : Submodule ℝ V)
    (h : integerSection b S ≠ ⊥) : 1 ≤ minimum (integerSection b S) := by
  apply (le_minimum_iff h).2
  intro x hx hx0
  obtain ⟨n, hn⟩ := Submodule.mem_one.mp (integerSection_integral b S hx hx)
  change (n : ℝ) = ⟪x, x⟫ at hn
  rw [real_inner_self_eq_norm_sq] at hn
  have hnpos : 0 < (n : ℝ) := hn ▸ sq_pos_of_pos (norm_pos_iff.mpr hx0)
  have hpos : 0 < n := by exact_mod_cast hnpos
  have hone : (1 : ℝ) ≤ (n : ℝ) := by exact_mod_cast (show 1 ≤ n by omega)
  nlinarith [norm_nonneg x, sq_nonneg (1 - ‖x‖)]

section Labels

omit [FiniteDimensional ℝ V]

variable (L : Submodule ℤ V) (g : ι → V) (q : ℕ) (hq : ∀ i, q • g i ∈ L)

include hq in
/-- Multiplication by the mark exponent embeds the preimage continuously into the old lattice. -/
theorem markedPreimage_discrete [DiscreteTopology L] (hq0 : q ≠ 0) :
    DiscreteTopology (markedPreimage L g) := by
  let f : V →ₗ[ℤ] V := (q : ℤ) • LinearMap.id
  have hf (x : V) : f x = q • x := by simp [f]
  have h : markedPreimage L g ≤ L.comap f := by
    rw [markedPreimage_eq, sup_le_iff, span_le]
    refine ⟨fun x hx ↦ ?_, ?_⟩
    · change f x ∈ L
      rw [hf]
      exact L.toAddSubmonoid.nsmul_mem hx q
    · rintro _ ⟨i, rfl⟩
      change f (g i) ∈ L
      rw [hf]
      exact hq i
  let φ (x : markedPreimage L g) : L := ⟨f x.val, h x.property⟩
  apply DiscreteTopology.of_continuous_injective (f := φ)
  · apply Continuous.subtype_mk
    simp only [hf]
    fun_prop
  · intro x y he
    have he' := congrArg Subtype.val he
    change f x.val = f y.val at he'
    simp only [hf, ← Nat.cast_smul_eq_nsmul ℝ] at he'
    exact Subtype.ext ((smul_right_injective V (Nat.cast_ne_zero.mpr hq0 : (q : ℝ) ≠ 0)) he')

private def pairingNumerator (ξ : metricDual L) (i : ι) : ℤ :=
  LinearMap.BilinForm.dualSubmodulePairing (innerₗ V) ξ ⟨q • g i, hq i⟩

private theorem pairingNumerator_spec (ξ : metricDual L) (i : ι) :
    (pairingNumerator L g q hq ξ i : ℝ) = (q : ℝ) * ⟪(ξ : V), g i⟫ := by
  simpa [pairingNumerator, ← Nat.cast_smul_eq_nsmul ℝ, inner_smul_right] using
    (LinearMap.BilinForm.dualSubmodulePairing_spec (innerₗ V) ξ ⟨q • g i, hq i⟩)

/-- Coordinates of the character on the chosen order-dividing-`q` marks. -/
def markLabel : metricDual L →+ (ι → ZMod q) where
  toFun ξ i := (pairingNumerator L g q hq ξ i : ZMod q)
  map_zero' := by
    ext i
    have h : pairingNumerator L g q hq 0 i = 0 := by
      exact_mod_cast (by simpa using pairingNumerator_spec L g q hq 0 i :
        (pairingNumerator L g q hq 0 i : ℝ) = 0)
    simp [h]
  map_add' x y := by
    ext i
    have h : pairingNumerator L g q hq (x + y) i =
        pairingNumerator L g q hq x i + pairingNumerator L g q hq y i := by
      apply Int.cast_injective (α := ℝ)
      simp only [Int.cast_add, pairingNumerator_spec, Submodule.coe_add, inner_add_left, mul_add]
    simp [h]

theorem markLabel_apply_spec (ξ : metricDual L) (i : ι) :
    ∃ z : ℤ, (z : ℝ) = (q : ℝ) * ⟪(ξ : V), g i⟫ ∧ markLabel L g q hq ξ i = (z : ZMod q) :=
  ⟨_, pairingNumerator_spec L g q hq ξ i, rfl⟩

/-- For nonzero `q`, the character is trivial precisely on the dual of the full preimage. -/
theorem markLabel_ker (hq0 : q ≠ 0) :
    (markLabel L g q hq).ker =
      (metricDual (markedPreimage L g)).toAddSubgroup.comap (metricDual L).subtype.toAddMonoidHom := by
  ext ξ
  change (fun i ↦ (pairingNumerator L g q hq ξ i : ZMod q)) = 0 ↔
    (ξ : V) ∈ metricDual (markedPreimage L g)
  let T := (1 : Submodule ℤ ℝ).comap (((innerₗ V) ξ.val).restrictScalars ℤ)
  change _ ↔ markedPreimage L g ≤ T
  rw [markedPreimage_eq, sup_le_iff, span_le]
  have hqR : (q : ℝ) ≠ 0 := by exact_mod_cast hq0
  constructor
  · intro h
    refine ⟨ξ.property, ?_⟩
    rintro _ ⟨i, rfl⟩
    obtain ⟨z, hz⟩ := (ZMod.intCast_zmod_eq_zero_iff_dvd _ q).mp (congrFun h i)
    apply Submodule.mem_one.mpr
    refine ⟨z, ?_⟩
    apply mul_left_cancel₀ hqR
    change (q : ℝ) * z = (q : ℝ) * ⟪(ξ : V), g i⟫
    rw [← pairingNumerator_spec L g q hq ξ i, hz]
    simp
  · rintro ⟨_, h⟩
    funext i
    obtain ⟨z, hz⟩ := Submodule.mem_one.mp (h ⟨i, rfl⟩)
    apply (ZMod.intCast_zmod_eq_zero_iff_dvd _ q).mpr
    refine ⟨z, Int.cast_injective (α := ℝ) ?_⟩
    change (z : ℝ) = ⟪(ξ : V), g i⟫ at hz
    simp [pairingNumerator_spec, hz]

/-- Distinct cosets receive distinct labels, with image the range of `markLabel`. -/
def markCosetEquivRange (hq0 : q ≠ 0) :
    (metricDual L ⧸ (metricDual (markedPreimage L g)).toAddSubgroup.comap
      (metricDual L).subtype.toAddMonoidHom) ≃+ (markLabel L g q hq).range :=
  (QuotientAddGroup.quotientAddEquivOfEq (markLabel_ker L g q hq hq0).symm).trans
    (QuotientAddGroup.quotientKerEquivRange _)

end Labels

section Graph

variable [Fintype ι] [Fintype η] (b : OrthonormalBasis (ι ⊕ η) ℝ V) (q : ℕ) (a : η → V)

/-- Integer columns for the graph lattice with chosen lifts of its horizontal offsets. -/
def markedGraphModule : Submodule ℤ V :=
  span ℤ (Set.range (fun i ↦ q • b (.inl i))) ⊔
    span ℤ (Set.range (fun j ↦ a j + b (.inr j)))

variable (S : Submodule ℝ V)
local notation "Λ" => projectedModule (markedGraphModule b q a) S
local notation "g" => (fun i ↦ S.orthogonalProjectionOnto (b (Sum.inl i)))

/-- A1 for the graph column presentation. -/
theorem graph_markedPreimage (ha : ∀ j, a j ∈ span ℤ (Set.range (fun i ↦ b (.inl i)))) :
    markedPreimage Λ g = projectedModule (cubicModule b) S := by
  rw [markedPreimage_projected, markedGraphModule, graph_sup_horizontal _ _ _ _ ha]
  congr 2
  exact congrArg Set.range (funext fun i ↦ by cases i <;> rfl)

theorem graph_mark_multiple (i : ι) : q • g i ∈ Λ := by
  refine ⟨q • b (.inl i), Submodule.mem_sup_left (subset_span ⟨i, rfl⟩), ?_⟩
  exact map_nsmul S.orthogonalProjectionOnto _ _

/-- The retained lattice's discreteness suffices for the integer section to be a lattice. -/
theorem graph_integerSection_lattice [DiscreteTopology Λ] (hq : q ≠ 0)
    (ha : ∀ j, a j ∈ span ℤ (Set.range (fun i ↦ b (.inl i)))) :
    ∃ _ : DiscreteTopology (integerSection b S), IsZLattice ℝ (integerSection b S) := by
  have h := markedPreimage_discrete Λ g q (graph_mark_multiple b q a S) hq
  rw [graph_markedPreimage _ _ _ _ ha] at h
  exact integerSection_lattice b S

/-- A2 and A3 together: the actual horizontal residue labels on the projected graph dual
have kernel the cubic integer section, viewed inside the retained dual. -/
theorem graph_markLabel_ker (hq : q ≠ 0)
    (ha : ∀ j, a j ∈ span ℤ (Set.range (fun i ↦ b (.inl i)))) :
    (markLabel Λ g q (graph_mark_multiple b q a S)).ker =
      (integerSection b S).toAddSubgroup.comap (metricDual Λ).subtype.toAddMonoidHom := by
  rw [markLabel_ker _ _ _ _ hq, graph_markedPreimage _ _ _ _ ha, metricDual_projected_cubic]

end Graph
