private def g (k : ℕ) : ℚ := (rows[k]!.1 : ℚ)/10^12
private def lg (k : ℕ) : ℚ := (rows[k]!.2.1 : ℚ)/10^12
private def peel (k : ℕ) : ℚ := (rows[k]!.2.2.1 : ℚ)/10^12
def logCap (k : ℕ) : ℚ := (rows[k]!.2.2.2 : ℚ)/10^12

private def gammaSq : ℕ → ℚ
  | 0 => 1
  | 1 => 9*3.14159265358979323847/16
  | k+2 => ((k:ℚ)/2+2)^2 * gammaSq k

private theorem gamma_sq (k : ℕ) : Gamma ((k:ℝ)/2+2)^2 ≤ (gammaSq k:ℝ) := by
  induction k using Nat.twoStepInduction with
  | zero => norm_num [gammaSq, Gamma_two]
  | one =>
    have hh := Gamma_add_one (show (3/2:ℝ) ≠ 0 by norm_num)
    have h := Gamma_add_one (show (1/2:ℝ) ≠ 0 by norm_num)
    norm_num at hh h ⊢
    rw [hh,h,Gamma_one_half_eq,mul_pow,mul_pow,sq_sqrt pi_pos.le]
    norm_num [gammaSq]
    linarith [pi_lt_d20]
  | more k ih _ =>
    rw [show ((k+2:ℕ):ℝ)/2+2 = ((k:ℝ)/2+2)+1 by push_cast; ring,
      Gamma_add_one (by positivity), mul_pow]
    simpa [gammaSq] using mul_le_mul_of_nonneg_left ih (sq_nonneg ((k:ℝ)/2+2))

private def hp : ℕ → ℚ
  | 2 => 4/3 | 3 => 2 | 4 => 4 | 5 => 8 | 6 => 64/3 | 7 => 64 | 8 => 256 | _ => 1

set_option maxRecDepth 10000
set_option maxHeartbeats 0

private theorem gamma_bound (k : ℕ) (hk : k ≤ 155) : flagGamma k ≤ g k := by
  have cert : ∀ i : Fin 156, 0 < g i ∧ (if i.val = 0 ∨ i.val = 1 then 1 ≤ g i
    else if i.val = 24 then 4 ≤ g i else if i.val ≤ 8 then hp i ≤ g i ^ i.val
    else gammaSq i ≤ (g i * 3.14159265358979323846/2)^i.val) := by decide +kernel
  obtain ⟨hg,H⟩ := cert ⟨k,by omega⟩
  change 0 < g k at hg
  have hg' : 0 < (g k : ℝ) := by exact_mod_cast hg
  change (if k = 0 ∨ k = 1 then _ else _) at H
  by_cases h0 : k = 0
  · subst k
    norm_num [flagGamma,auditedGamma,blichfeldtConstant,g,rows]
    exact (div_le_one pi_pos).mpr (by linarith [pi_gt_three])
  by_cases h1 : k = 1
  · subst k; norm_num [flagGamma,g,rows]
  by_cases h24 : k = 24
  · subst k; norm_num [flagGamma,g,rows]
  have hk' : 0 < (k:ℝ) := by exact_mod_cast (Nat.pos_of_ne_zero h0)
  simp only [flagGamma,if_neg h1,if_neg h24,auditedGamma]
  by_cases h8 : k ≤ 8
  · rw [if_pos ⟨by omega,h8⟩,div_eq_mul_inv,← rpow_def_of_pos]
    · apply (rpow_inv_le_iff_of_pos (by interval_cases k <;> norm_num [hermitePower]) hg'.le hk').mpr
      rw [rpow_natCast]
      have hh : hp k ≤ g k^k := by simpa [h0,h1,h24,h8] using H
      have eq : hermitePower k = (hp k : ℝ) := by interval_cases k <;> norm_num [hermitePower,hp]
      rw [eq]; exact_mod_cast hh
    · interval_cases k <;> norm_num [hermitePower]
  · rw [if_neg (by omega)]
    unfold blichfeldtConstant
    have hG := Gamma_pos_of_pos (by positivity : 0 < (k:ℝ)/2+2)
    have poweq : Gamma ((k:ℝ)/2+2)^(2/(k:ℝ)) = (Gamma ((k:ℝ)/2+2)^2)^((k:ℝ)⁻¹) := by
      rw [← rpow_natCast_mul hG.le]; norm_num [div_eq_mul_inv]
    rw [poweq,div_mul_eq_mul_div,div_le_iff₀ pi_pos]
    suffices (Gamma ((k:ℝ)/2+2)^2)^((k:ℝ)⁻¹) ≤ g k*π/2 by linarith
    apply (rpow_inv_le_iff_of_pos (sq_nonneg _) (by positivity) hk').mpr
    rw [rpow_natCast]
    have hh : gammaSq k ≤ (g k*3.14159265358979323846/2)^k := by simpa [h0,h1,h24,h8] using H
    apply (gamma_sq k).trans ((Rat.cast_le (K := ℝ)).2 hh |>.trans ?_)
    push_cast
    apply pow_le_pow_left₀ (by positivity)
    gcongr
    linarith [pi_gt_d20]

private theorem gamma_pos (k : ℕ) : 0 < flagGamma k := by
  unfold flagGamma; split <;> first | positivity | split <;> first | positivity | exact auditedGamma_pos _

private theorem log_gamma (k : ℕ) (hk : k ≤ 155) : log (flagGamma k) ≤ lg k := by
  have check : ∀ i : Fin 156, 0 ≤ lg i ∧ g i ≤ taylor (lg i/4) 20 ^ 4 := by decide +kernel
  obtain ⟨h₁,h₂⟩ := check ⟨k,by omega⟩
  change 0 ≤ lg k at h₁
  change g k ≤ taylor (lg k/4) 20 ^ 4 at h₂
  apply (log_le_iff_le_exp (gamma_pos _)).mpr
  apply (gamma_bound _ hk).trans
  have hh := exp_lower (lg k/4) (taylor (lg k/4) 20) (by positivity) le_rfl
  have ht : 0 ≤ taylor (lg k/4) 20 := by unfold taylor; positivity
  have eq : (lg k:ℝ) = (4:ℕ)*((lg k/4:ℚ):ℝ) := by push_cast; ring
  rw [eq, exp_nat_mul]
  apply ((Rat.cast_le (K := ℝ)).2 h₂).trans
  rw [Rat.cast_pow]
  exact pow_le_pow_left₀ (by exact_mod_cast ht) hh 4

private theorem peel_bound (k : ℕ) (hk : k ≤ 155) :
    (∑ m ∈ Icc 2 k, log (flagGamma m)/(2*((m:ℝ)-1))) ≤ peel k := by
  induction k with
  | zero => norm_num [peel,rows]
  | succ k ih =>
    by_cases h : k = 0
    · subst k; norm_num [peel,rows]
    rw [sum_Icc_succ_top (by omega)]
    have cert : ∀ i : Fin 155, 0 < i.val →
      peel i + lg (i.val+1)/(2*(i.val:ℚ)) ≤ peel (i.val+1) := by decide +kernel
    have hh := (Rat.cast_le (K := ℝ)).2 (cert ⟨k,by omega⟩ (Nat.pos_of_ne_zero h))
    push_cast at hh ⊢
    simp only [add_sub_cancel_right] at *
    exact (add_le_add (ih (by omega))
      (div_le_div_of_nonneg_right (log_gamma (k+1) hk) (by positivity))).trans hh

private theorem cap_pos (k : ℕ) : 0 < flagCap k := by
  induction k with
  | zero => exact zero_lt_one
  | succ k ih => exact ih.trans_le (le_max_left ..)

/-- Rational upper bound for each log cap, including the running maximum. -/
theorem log_flagCap (k : ℕ) (hk : k ≤ 155) : log (flagCap k) ≤ logCap k := by
  induction k with
  | zero => norm_num [flagCap,logCap,rows]
  | succ k ih =>
    let a := sqrt (flagGamma (k+1)) * ∏ m ∈ Icc 2 (k+1),
      (flagGamma m) ^ (1/(2*((m:ℝ)-1)))
    have H : ∀ i : Fin 155, logCap i ≤ logCap (i.val+1) ∧
        lg (i.val+1)/2+peel (i.val+1) ≤ logCap (i.val+1) := by decide +kernel
    obtain ⟨H₁,H₂⟩ := H ⟨k,by omega⟩
    change _ ≤ (logCap (k+1):ℝ)
    rcases max_choice (flagCap k) a with h | h
    · change log (max _ a) ≤ _
      rw [h]; exact (ih (by omega)).trans (by exact_mod_cast H₁)
    · change log (max _ a) ≤ _
      rw [h]
      have eq : log a = log (flagGamma (k+1))/2 +
          ∑ m ∈ Icc 2 (k+1), log (flagGamma m)/(2*((m:ℝ)-1)) := by
        unfold a
        rw [log_mul (sqrt_pos.mpr (gamma_pos _)).ne' (Finset.prod_ne_zero_iff.mpr
          (fun _ _ ↦ (rpow_pos_of_pos (gamma_pos _) _).ne')), log_sqrt (gamma_pos _).le,
          log_prod (fun _ _ ↦ (rpow_pos_of_pos (gamma_pos _) _).ne')]
        congr 1
        apply sum_congr rfl
        intro m _
        rw [log_rpow (gamma_pos _)]
        ring
      rw [eq]
      apply (add_le_add (div_le_div_of_nonneg_right (log_gamma (k+1) hk) (by norm_num))
        (peel_bound (k+1) hk)).trans
      exact_mod_cast H₂

/-- All physical flag tests are strictly below the modulus. -/
theorem radius_lt_modulus (u : FlagIndex) : flagRadius u < 3329 := by
  let k := 155-u.1.val-u.2.val
  have hk : k ≤ 155 := by dsimp [k]; omega
  have H : ∀ i : Fin 156, logCap i ≤ 4.57 := by decide +kernel
  have hl := (log_flagCap k hk).trans ((Rat.cast_le (K := ℝ)).2 (H ⟨k,by omega⟩))
  have h := exp_upper (4.57/8) 1.78 (by decide +kernel) (by decide +kernel) (by decide +kernel)
  have e : (4.57:ℝ) = (8:ℕ)*((4.57/8:ℚ):ℝ) := by norm_num
  have hc : flagCap k ≤ 1.78^8 := by
    rw [← exp_log (cap_pos k)]
    apply (exp_le_exp.mpr (by simpa using hl : log (flagCap k) ≤ 4.57)).trans
    rw [e,exp_nat_mul]
    exact pow_le_pow_left₀ (exp_pos _).le (by simpa using h) 8
  have hr : planeRadius ≤ 31 := by
    unfold planeRadius areaCut
    apply (sqrt_le_left (by norm_num)).mpr
    rw [mul_div_assoc',div_div,← sq,sq_sqrt (by norm_num : (0:ℝ) ≤ 3)]
    norm_num
  exact (mul_le_mul hr hc (cap_pos k).le (by norm_num)).trans_lt (by norm_num)

end SigabaNeo.Wall1.ControlledPlane.FlagEnvelope

