module

public import Definitions.Def_LatticeAttack_Reduction_Rogers_MeanValue

set_option autoImplicit true

@[expose] public section
noncomputable section
open MeasureTheory Submodule.IsPrincipal
open scoped ENNReal
namespace SigabaNeo.Rogers

/-- Image of the congruence map on row coefficients, generated by the rows modulo q. -/
def rowImage {r k q : ℕ} (D : Diagram r k q) : AddSubgroup (Fin k → ZMod q) :=
  AddSubgroup.closure (Set.range fun i j ↦ (D.entry i j : ZMod q))

theorem denominator_dvd_rowIndex {r k q : ℕ} (D : Diagram r k q) :
    q ∣ Nat.card (rowImage D) := by
  let m := Nat.card (rowImage D)
  let J : Ideal ℤ :=
    { carrier := {z | (m : ZMod q) * (z : ZMod q) = 0}
      zero_mem' := by simp
      add_mem' := by
        intro a b ha hb
        change (m : ZMod q) * ((a+b : ℤ) : ZMod q) = 0
        rw [Int.cast_add, mul_add, show (m : ZMod q) * (a : ZMod q) = 0 from ha,
          show (m : ZMod q) * (b : ZMod q) = 0 from hb, add_zero]
      smul_mem' := by
        intro a b hb
        change (m : ZMod q) * ((a*b : ℤ) : ZMod q) = 0
        rw [Int.cast_mul, mul_left_comm, show (m : ZMod q) * (b : ZMod q) = 0 from hb, mul_zero] }
  have he (i j) : D.entry i j ∈ J := by
    let v : rowImage D := ⟨_, AddSubgroup.subset_closure (Set.mem_range_self i)⟩
    have h := congrArg (fun z : rowImage D ↦ z.val j) (card_nsmul_eq_zero' (x := v))
    change m • (D.entry i j : ZMod q) = 0 at h
    rw [nsmul_eq_mul] at h
    exact h
  have hg := D.primitive (generator J).natAbs fun i j ↦ by
    simpa using ((mem_iff_generator_dvd J).mp (he i j))
  have hunit : IsUnit (generator J) := by
    exact Int.isUnit_iff_natAbs_eq.mpr hg
  have htop := J.eq_top_of_isUnit_mem (generator_mem J) hunit
  have hone : (1 : ℤ) ∈ J := htop ▸ Submodule.mem_top
  exact (ZMod.natCast_eq_zero_iff m q).mp (by simpa [J] using hone)

def congruenceCoefficient (n : ℕ) : Coefficients :=
  fun _ _ _ D ↦ ENNReal.ofReal ((Nat.card (rowImage D) : ℝ) ^ (-(n : ℝ)))

theorem coefficient_bound (n k : ℕ) (r : Fin k) (q : ℕ) (D : Diagram (r.val+1) k (q+1)) :
    congruenceCoefficient n k r q D ≤ ENNReal.ofReal (((q+1 : ℕ) : ℝ) ^ (-(n : ℝ))) := by
  apply ENNReal.ofReal_le_ofReal
  apply Real.rpow_le_rpow_of_nonpos (by positivity) _ (neg_nonpos.mpr (Nat.cast_nonneg n))
  exact_mod_cast Nat.le_of_dvd Nat.card_pos (denominator_dvd_rowIndex D)

theorem coefficient_one (n k : ℕ) (r : Fin k) (D : Diagram (r.val+1) k 1) :
    congruenceCoefficient n k r 0 D = 1 := by
  simp [congruenceCoefficient, Nat.card_unique]

/-- For these explicit coefficients the sole remaining field is the workload identity. -/
theorem classicalRogersFormula_iff {n : ℕ} (ν : Measure (LatticeSpace n)) :
    ClassicalRogersFormula ν (congruenceCoefficient n) ↔
      ∀ k, 1 ≤ k → k < n → ∀ F : (Fin k → E n) → ℝ≥0∞, Admissible F →
        (∫⁻ L, tupleWorkload F L ∂ν) = diagramSum (congruenceCoefficient n) F :=
  ⟨fun h ↦ h.formula, fun h ↦ ⟨coefficient_bound n, coefficient_one n, h⟩⟩

end SigabaNeo.Rogers
