def table : Array Row := part0 ++ part1 ++ part2 ++ part3 ++ part4 ++ part5 ++ part6 ++ part7 ++ part8 ++ part9 ++ part10 ++ part11 ++ part12 ++ part13 ++ part14 ++ part15 ++ part16 ++ part17 ++ part18 ++ part19 ++ part20 ++ part21 ++ part22 ++ part23 ++ part24 ++ part25 ++ part26 ++ part27 ++ part28 ++ part29 ++ part30 ++ part31 ++ part32 ++ part33 ++ part34 ++ part35 ++ part36 ++ part37 ++ part38 ++ part39 ++ part40 ++ part41 ++ part42 ++ part43 ++ part44 ++ part45 ++ part46 ++ part47 ++ part48 ++ part49 ++ part50 ++ part51 ++ part52 ++ part53 ++ part54 ++ part55 ++ part56 ++ part57 ++ part58 ++ part59 ++ part60 ++ part61 ++ part62 ++ part63 ++ part64 ++ part65 ++ part66 ++ part67 ++ part68 ++ part69 ++ part70 ++ part71 ++ part72 ++ part73 ++ part74 ++ part75 ++ part76
def padStart:= 11136351
def padEnd:= 11151789
def bound:= 11171595
def key (t : Nat) : Row :=
  if t<3044 then table[t]! else if t<8190 then (0,if t%2==0 then 3 else 1,0)
  else table[3044+t-8190]!
def bankStart:=1031
def ctl:=bankStart+(8192+514)*27
def nstates:=ctl+16
structure Action where
  state : Nat
  move : SignType :=0
  head : SignType :=0
  write : Option (Option Bool) :=none
  output : Option Bool :=none
def trans (q : Nat) (inp tape : Option Bool) : Action := Id.run do
  let fail:=ctl+8
  let bad : Action:=⟨fail,0,0,none,none⟩
  let atState:=fun (t f p:Nat) =>
    if t>=8192 then ctl+1 else if t>=514 && f==0 then fail else
    bankStart+27*(if t<514 then 2*t+f else 514+t)+p
  if q<1031 then
    return if inp==some (!(q==513 || q==1027 || q==1029 || q==1030)) then
      {state:=q+1,move:=1} else bad
  if q<ctl then
    let code:=q-bankStart
    let j:=code/27
    let t:=if j<1028 then j/2 else j-514
    let flag:=if j<1028 then j%2 else 1
    let st:=code%27
    let go:=atState t flag
    let next:=atState (t+1) flag 0
    let tokenRow:=key t
    let opt:=tokenRow.2.2>0
    let size:=tokenRow.2.1-(if opt then 1 else 0)
    if st==0 then
      if opt then return if inp==some true then {state:=go 1,move:=1} else bad
      return {state:=go 2}
    if st==1 then
      if inp==some false then return {state:=next,move:=1}
      return if inp==some true then {state:=atState t 1 2} else bad
    if st==2 then return {state:=go 3,head:=1}
    if st<19 then return {state:=go (st+1),head:=1,write:=some (some (size.testBit (st-3)))}
    if st==19 then return {state:=go 20,head:= -1}
    if st==20 || st==23 then
      return if tape.isNone then {state:=go 21,head:=1} else {state:=go st,head:= -1}
    if st==21 || st==22 then
      if st==21 && inp != some true then
        return if inp==some false then {state:=go 24,move:=1} else bad
      let advance : SignType:=if st==21 then 1 else 0
      if tape==some true then return {state:=go 23,move:=advance,head:= -1,write:=some (some false)}
      return if tape==some false then {state:=go 22,move:=advance,head:=1,write:=some (some true)} else bad
    if st==24 then
      if tape==some false then return {state:=go 24,head:=1}
      return if tape.isNone then {state:=go 25,head:= -1} else bad
    if st==25 then return if tape.isNone then {state:=next} else {state:=go 25,head:= -1}
    return bad
  match q-ctl with
  | 1 => return if inp==some false then {state:=ctl+2,move:=1} else bad
  | 2 => return if inp==some true then {state:=ctl+3,move:=1} else bad
  | 3 => return if let some b:=inp then {state:=ctl+4+b.toNat,move:=1} else bad
  | 4 | 5 => return if inp==some false then {state:=q+2,move:=1} else bad
  | 6 | 7 => return if inp.isNone then {state:=q+2} else bad
  | 8 | 9 => return {state:=q+2,output:=some true}
  | 10 | 11 => return {state:=ctl+12,output:=some (q==ctl+11)}
  | _ => return {state:=nstates,output:=some false}
def enc : Machine where
  tapes:=1
  states:=nstates
  time:=10*bound+100*8192+2048
  machine:={
    initial:=⟨0,by decide⟩
    tr:=fun q inp ws _ _ =>
      let a:=trans q.val inp (ws 0)
      .step {inputTape:=a.move, workTapes:=fun _ => (a.write,a.head), output:=a.output,
             state:=if h:a.state<nstates then some ⟨a.state,h⟩ else none}
          Fin.elim0 Fin.elim0}

def dec : Machine where
  tapes := 0
  states := 7
  time := bound+300
  machine := {
    initial := ⟨0,by decide⟩
    tr := fun q inp _ _ _ =>
      let i:=q.val
      let n:=if i==6 then 6 else if i%2==1 then i-1 else if inp==some true then i+1 else i+2
      .step {inputTape := 1,workTapes := Fin.elim0,
             output := if i==6 then inp else none
             state := if inp.isNone then none else if h : n<7 then some ⟨n,h⟩ else none}
            (fun j => Fin.elim0 j) (fun j => Fin.elim0 j)}
end LinearProjectRole
