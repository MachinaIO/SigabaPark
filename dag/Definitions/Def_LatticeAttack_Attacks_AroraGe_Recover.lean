import Definitions.Def_LatticeAttack_Attacks_AroraGe_Identity
import SigabaNeoStd.Lattices.Algorithms.Gauss

set_option autoImplicit true

/-!
# Arora–Ge linearization in `n` variables, end to end

Public input: `m` samples `(a_i, b_i)` with `b_i = a_i·s + e_i` and every error in a known set
`E` (`|E| < q`). The attack expands each `∏_{r∈E}(b_i − a_i·X − r)` (`row E b_i (−a_i)`), moves the
constant coefficient to the right, solves the linear system in the monomials of degree `1..|E|`
by verified Gaussian elimination (`Gauss.solve`), and reads the degree-one coordinates.

* `recover_correct`: whenever the sample tuple is outside `failures` (the rank-deficient tuples),
  the attack outputs exactly `s`.
* `recover_failure_probability`: over uniform `(e_i, a_i) ∈ E × F_q^n`, the fraction of tuples on
  which the attack does not output `s` is `≤ (q^M − 1)(1 − 1/(|E| q^n))^m`, `M = #monomials`.
* `recover_fieldOps`: elimination uses at most `5·m·M·(M+1)` field operations.
-/

namespace SigabaNeo.Lattices.AroraGe.Multi

open MvPolynomial

variable {q n : ℕ} [Fact q.Prime]

/-- The monomial index set as a type and its enumeration. -/
noncomputable abbrev cols (n D : ℕ) := Fintype.equivFin (indices n D)

/-- The public linear system built from samples `(a_i, b_i)`. -/
noncomputable def pubMatrix (E : Finset (ZMod q)) {m : ℕ}
    (smp : Fin m → (Fin n → ZMod q) × ZMod q) :
    Matrix (Fin m) (Fin (Fintype.card (indices n E.card))) (ZMod q) :=
  fun i j ↦ (row E (smp i).2 (-(smp i).1)).coeff ((cols n E.card).symm j).val

noncomputable def pubRhs (E : Finset (ZMod q)) {m : ℕ}
    (smp : Fin m → (Fin n → ZMod q) × ZMod q) : Fin m → ZMod q :=
  fun i ↦ -(row E (smp i).2 (-(smp i).1)).coeff 0

/-- The attack: solve, then read the coordinates at the degree-one monomials. -/
noncomputable def recover (E : Finset (ZMod q)) (hE : 1 ≤ E.card) {m : ℕ}
    (smp : Fin m → (Fin n → ZMod q) × ZMod q) : Option (Fin n → ZMod q) × ℕ :=
  let r := Gauss.solve (pubMatrix E smp) (pubRhs E smp)
  (r.1.map fun y i ↦ y (cols n E.card ⟨Finsupp.single i 1, single_mem_indices hE i⟩), r.2)

/-- The samples generated by errors and directions `p i = (e_i, a_i)`. -/
def samples (s : Fin n → ZMod q) {m : ℕ} (p : Fin m → ZMod q × (Fin n → ZMod q)) :
    Fin m → (Fin n → ZMod q) × ZMod q :=
  fun i ↦ ((p i).2, (p i).1 + dotProduct (p i).2 s)

theorem pubMatrix_samples (E : Finset (ZMod q)) (s : Fin n → ZMod q) {m : ℕ}
    (p : Fin m → ZMod q × (Fin n → ZMod q)) (i) (j) :
    pubMatrix E (samples s p) i j = matrix E s p i ((cols n E.card).symm j) := rfl

theorem pubRhs_samples (E : Finset (ZMod q)) (s : Fin n → ZMod q) {m : ℕ}
    (p : Fin m → ZMod q × (Fin n → ZMod q)) :
    pubRhs E (samples s p) = -(fun i ↦ (sampleRow E s (p i).2 (p i).1).coeff 0) := rfl

/-- Outside the failure set the linearized matrix has trivial kernel. -/
theorem ker_trivial (E : Finset (ZMod q)) (s : Fin n → ZMod q) {m : ℕ}
    (p : Fin m → ZMod q × (Fin n → ZMod q)) (hp : ∀ i, (p i).1 ∈ E)
    (hf : p ∉ failures E s m) {v : indices n E.card → ZMod q}
    (hv : (matrix E s p).mulVec v = 0) : v = 0 := by
  by_contra h
  apply hf
  refine Finset.mem_biUnion.mpr ⟨v, Finset.mem_erase.mpr ⟨h, Finset.mem_univ _⟩, ?_⟩
  refine Fintype.mem_piFinset.mpr fun i ↦ Finset.mem_filter.mpr
    ⟨Finset.mem_product.mpr ⟨hp i, Finset.mem_univ _⟩, ?_⟩
  have := congrFun hv i
  simpa [Matrix.mulVec, dotProduct, matrix] using this

theorem recover_correct (E : Finset (ZMod q)) (hE : 1 ≤ E.card) (s : Fin n → ZMod q) {m : ℕ}
    (p : Fin m → ZMod q × (Fin n → ZMod q)) (hp : ∀ i, (p i).1 ∈ E)
    (hf : p ∉ failures E s m) :
    (recover E hE (samples s p)).1 = some s := by
  set M := pubMatrix E (samples s p)
  set c := pubRhs E (samples s p)
  set ystar : Fin (Fintype.card (indices n E.card)) → ZMod q :=
    fun j ↦ monomialValues s E.card ((cols n E.card).symm j)
  have hstar : M.mulVec ystar = c := by
    have h := mulVec_monomialValues E s p hp
    ext i
    have hi := congrFun h i
    simp only [Matrix.mulVec, dotProduct] at hi ⊢
    change _ = (-(fun i ↦ (sampleRow E s (p i).2 (p i).1).coeff 0)) i
    rw [← hi]
    exact Fintype.sum_equiv (cols n E.card).symm _ _ fun j ↦ rfl
  have hker : LinearMap.ker M.mulVecLin = ⊥ := by
    rw [LinearMap.ker_eq_bot']
    intro w hw
    have hw' : (matrix E s p).mulVec (fun d ↦ w (cols n E.card d)) = 0 := by
      ext i
      have hi := congrFun hw i
      simp only [Matrix.mulVecLin_apply, Matrix.mulVec, dotProduct, Pi.zero_apply] at hi ⊢
      rw [← hi]
      exact (Fintype.sum_equiv (cols n E.card) _ _ fun d ↦ by simp [M, pubMatrix_samples])
    have := ker_trivial E s p hp hf hw'
    ext j
    simpa using congrFun this ((cols n E.card).symm j)
  have hc : c ∈ Submodule.span (ZMod q) (Set.range M.col) := by
    rw [← Matrix.range_mulVecLin, ← hstar]
    exact LinearMap.mem_range_self _ _
  obtain ⟨y, hy, -, huniq⟩ := Gauss.complete M c hker hc
  have : y = ystar := (huniq ystar hstar).symm
  subst this
  change Option.map _ (Gauss.solve M c).1 = _
  rw [hy, Option.map_some]
  congr 1
  funext i
  simp only [ystar, Equiv.symm_apply_apply]
  exact monomialValues_single s hE i

theorem recover_fieldOps (E : Finset (ZMod q)) (hE : 1 ≤ E.card) {m : ℕ}
    (smp : Fin m → (Fin n → ZMod q) × ZMod q) :
    (recover E hE smp).2 ≤ 5 * m * (indices n E.card).card * ((indices n E.card).card + 1) := by
  have := Gauss.fieldOps_le (pubMatrix E smp) (pubRhs E smp)
  simpa [recover, Fintype.card_coe] using this

/-- **Arora–Ge in `n` variables, end to end.** Over uniform errors in `E` and uniform directions,
the attack outputs `s` except on a fraction `≤ (q^M − 1)(1 − 1/(|E| q^n))^m` of sample tuples, with
at most `5·m·M·(M+1)` field operations for elimination. -/
theorem recover_failure_probability (E : Finset (ZMod q)) (hE : 1 ≤ E.card) (hq : E.card < q)
    (s : Fin n → ZMod q) (m : ℕ) :
    (((Fintype.piFinset fun _ : Fin m ↦ E ×ˢ (Finset.univ : Finset (Fin n → ZMod q))).filter
        fun p ↦ (recover E hE (samples s p)).1 ≠ some s).card : ℚ) /
        (E.card * (q : ℚ) ^ n) ^ m ≤
      (q ^ (indices n E.card).card - 1 : ℕ) * (1 - 1 / (E.card * (q : ℚ) ^ n)) ^ m := by
  refine le_trans ?_ (failure_probability E (Finset.card_pos.mp hE) hq s m)
  apply div_le_div_of_nonneg_right _ (by positivity)
  norm_cast
  apply Finset.card_le_card
  intro p hp
  obtain ⟨hpE, hne⟩ := Finset.mem_filter.mp hp
  have hpE' : ∀ i, (p i).1 ∈ E := fun i ↦
    (Finset.mem_product.mp (Fintype.mem_piFinset.mp hpE i)).1
  by_contra hf
  exact hne (recover_correct E hE s p hpE' hf)

end SigabaNeo.Lattices.AroraGe.Multi

#print axioms SigabaNeo.Lattices.AroraGe.Multi.recover_correct
#print axioms SigabaNeo.Lattices.AroraGe.Multi.recover_fieldOps
#print axioms SigabaNeo.Lattices.AroraGe.Multi.recover_failure_probability
